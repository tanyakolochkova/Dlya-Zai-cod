script
style
root{
  --bg#25221F;--deep#1B1815;--soft#2C2825;
  --fg#D8C6BB;--strong#EDE3DB;--dimrgba(216,198,187,.6);--faintrgba(216,198,187,.35);
  --sand#C6AE94;--glow#E0B784;--logo#CBB9AD;
  --linergba(216,198,187,.13);--line2rgba(198,174,148,.32);
  --sans'Manrope Variable','Manrope',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --padclamp(20px,4.5vw,64px);--ecubic-bezier(.16,1,.3,1);
}
,before,after{box-sizingborder-box}
html{scroll-behaviorsmooth}
body{margin0;backgroundvar(--bg);colorvar(--fg);font-familyvar(--sans);font-weight300;font-size16px;line-height1.65;overflow-xhidden;-webkit-font-smoothingantialiased}
body.locked{overflowhidden}
a{colorinherit;text-decorationnone}
button{fontinherit;colorinherit;backgroundnone;border0;cursorpointer}
h1,h2,h3,h4{font-familyvar(--sans);margin0;line-height1.05;font-weight800;text-transformuppercase;letter-spacing.02em}
p{margin0}ul{margin0;padding0;list-stylenone}
img,svg{displayblock;max-width100%}
selection{backgroundvar(--sand);color#1B1815}
.grain{positionfixed;inset0;z-index9990;pointer-eventsnone;opacity.045;background-imageurl(dataimagesvg+xml;utf8,svg xmlns='httpwww.w3.org2000svg' width='180' height='180'filter id='n'feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2'filterrect width='180' height='180' filter='url(%23n)'svg)}
.wrap{max-width1500px;margin0 auto;padding0 var(--pad)}
.lab{font-size10px;font-weight500;letter-spacing.3em;text-transformuppercase;colorvar(--sand)}
.art{positionrelative;background
  radial-gradient(85% 65% at 72% 16%,rgba(224,183,132,.2),transparent 62%),
  linear-gradient(200deg,#4A4034 0%,#2A2520 46%,#161310 100%);overflowhidden}
.art svg{positionabsolute;inset0;width100%;height100%}
.artimg.fill{positionabsolute;inset0;width100%;height100%;object-fitcover}

 preloader 
.pre{positionfixed;inset0;z-index10000;backgroundvar(--deep);displaygrid;place-itemscenter;transitionopacity .8s var(--e),visibility .8s}
.pre.done{opacity0;visibilityhidden}
.pre-in{displayflex;flex-directioncolumn;align-itemscenter;gap20px}
.pre-w{font-sizeclamp(1.6rem,6vw,3rem);font-weight200;letter-spacing.5em;text-indent.5em;colorvar(--logo)}
.pre-b{widthmin(200px,48vw);height1px;backgroundrgba(216,198,187,.16);positionrelative}
.pre-b i{positionabsolute;inset0;backgroundvar(--sand);transformscaleX(0);transform-originleft;transitiontransform .2s linear}

 header 
.nav{positionfixed;top0;left0;right0;z-index8000;displaygrid;grid-template-columns1fr auto 1fr;align-itemscenter;gap16px;paddingclamp(12px,1.6vw,20px) var(--pad);transitionbackground .5s,padding .5s,border-color .5s;border-bottom1px solid transparent}
.nav.stuck{backgroundrgba(27,24,21,.94);border-bottom-colorvar(--line);padding-top9px;padding-bottom9px}
.nav-l{displayflex;align-itemscenter;gapclamp(14px,2vw,30px)}
.nav-l a{positionrelative;font-size11px;font-weight500;letter-spacing.16em;text-transformuppercase;colorvar(--dim);padding6px 0;transitioncolor .4s;white-spacenowrap}
.nav-l aafter{content'';positionabsolute;left0;bottom0;height1px;width100%;backgroundvar(--sand);transformscaleX(0);transform-originright;transitiontransform .5s var(--e)}
.nav-l ahover{colorvar(--strong)}
.nav-l ahoverafter{transformscaleX(1);transform-originleft}
 логотип по центру, без нижней подписи (обрезка рамкой) 
.logo-slot{justify-selfcenter;positionrelative;displayblock;heightclamp(24px,2.9vw,36px);aspect-ratio5.61;overflowhidden;border1px dashed transparent;transitionborder-color .4s}
.logo-slot img{positionabsolute;left0;top0;width100%;heightauto;displaynone}
.logo-slot.has-logo img{displayblock}
.logo-slot.has-logo .logo-wm{displaynone}
.logo-wm{displayflex;align-itemscenter;height100%;font-sizeclamp(14px,2vw,24px);font-weight300;letter-spacing.5em;text-indent.5em;colorvar(--logo);white-spacenowrap}
.logo-slot.drag{border-colorvar(--line2)}
.nav-r{displayflex;align-itemscenter;justify-contentflex-end;gapclamp(10px,1.4vw,18px)}
.socs{displayflex;align-itemscenter;gapclamp(8px,1vw,14px)}
.socs a{displaygrid;place-itemscenter;width30px;height30px;border1px solid var(--line);border-radius50%;colorvar(--dim);transition.4s}
.socs ahover{color#1B1815;backgroundvar(--sand);border-colorvar(--sand);transformtranslateY(-2px)}
.socs svg{width13px;height13px;fillcurrentColor}
.btn{positionrelative;displayinline-flex;align-itemscenter;justify-contentcenter;gap10px;padding12px 24px;border1px solid var(--line2);border-radius100px;font-size11px;font-weight600;letter-spacing.16em;text-transformuppercase;overflowhidden;transitioncolor .5s,border-color .5s;white-spacenowrap}
.btn span{positionrelative;z-index2}
.btnbefore{content'';positionabsolute;inset0;backgroundvar(--sand);transformtranslateY(101%);transitiontransform .6s var(--e)}
.btnhover{color#1B1815;border-colorvar(--sand)}
.btnhoverbefore{transformtranslateY(0)}
.btn.solid{backgroundvar(--sand);color#1B1815;border-colorvar(--sand)}
.btn.solidbefore{backgroundvar(--strong)}
.btn.icon{padding0;width40px;height40px;displaynone}
.burger{width42px;height42px;positionrelative;flex0 0 auto}
.burger i{positionabsolute;left10px;width22px;height1.5px;backgroundvar(--fg);transition.45s var(--e)}
.burger inth-child(1){top16px}.burger inth-child(2){top22px}.burger inth-child(3){top28px;width14px}
.burger.open inth-child(1){top22px;transformrotate(45deg)}
.burger.open inth-child(2){opacity0}
.burger.open inth-child(3){top22px;width22px;transformrotate(-45deg)}

 drawer 
.drawer{positionfixed;top0;right0;bottom0;widthmin(440px,92vw);z-index8500;backgroundvar(--deep);border-left1px solid var(--line);transformtranslateX(102%);transitiontransform .8s var(--e);overflow-yauto;padding90px clamp(24px,4vw,44px) 40px}
.drawer.open{transformnone}
.drawer nav{displaygrid;gap2px;border-bottom1px solid var(--line);padding-bottom22px}
.drawer nav a{font-sizeclamp(1.3rem,4.6vw,1.7rem);font-weight700;text-transformuppercase;letter-spacing.04em;colorvar(--strong);padding9px 0;displayflex;justify-contentspace-between;align-itemscenter;transitioncolor .3s,padding-left .4s var(--e)}
.drawer nav ahover{colorvar(--sand);padding-left10px}
.drawer nav a small{font-size10px;font-weight500;letter-spacing.2em;colorvar(--faint)}
.dr-block{padding24px 0;border-bottom1px solid var(--line)}
.dr-block h4{font-size11px;font-weight600;letter-spacing.26em;colorvar(--sand);margin-bottom16px}
.price{displayflex;justify-contentspace-between;gap16px;padding10px 0;border-bottom1px dashed var(--line);font-size13.5px}
.pricelast-child{border-bottom0}
.price b{font-weight500;colorvar(--strong);white-spacenowrap}
.price span{colorvar(--dim)}
.dr-socs{displayflex;gap10px;flex-wrapwrap;padding-top22px}
.dr-socs a{padding10px 16px;border1px solid var(--line);border-radius100px;font-size10px;font-weight600;letter-spacing.14em;text-transformuppercase;colorvar(--dim);transition.4s}
.dr-socs ahover{backgroundvar(--sand);color#1B1815;border-colorvar(--sand)}
.dr-contact{padding-top22px;font-size13px;colorvar(--dim);displaygrid;gap6px}
.dr-contact a{colorvar(--strong)}
.scrim{positionfixed;inset0;z-index8400;backgroundrgba(15,13,12,.6);opacity0;visibilityhidden;transition.6s}
.scrim.on{opacity1;visibilityvisible}

 dots nav 
.dots{positionfixed;rightclamp(10px,1.6vw,22px);top50%;transformtranslateY(-50%);z-index7000;displaygrid;gap12px}
.dots button{width8px;height8px;border-radius50%;backgroundrgba(216,198,187,.25);positionrelative;transition.4s;padding0}
.dots button.on{backgroundvar(--sand);box-shadow0 0 0 4px rgba(198,174,148,.15)}
.dots buttonafter{contentattr(data-t);positionabsolute;right18px;top50%;transformtranslateY(-50%);font-size9px;letter-spacing.16em;text-transformuppercase;colorvar(--sand);opacity0;white-spacenowrap;transitionopacity .3s;pointer-eventsnone}
.dots buttonhoverafter{opacity1}

 hero 
.hero{positionrelative;min-height100vh;displayflex;align-itemscenter;overflowhidden}
.hero-bg{positionabsolute;inset0;z-index0}
.hero-bg .kb{positionabsolute;inset-6%;animationkb 30s ease-in-out infinite alternate}
@keyframes kb{from{transformscale(1.04) translate(1.2%,.8%)}to{transformscale(1.16) translate(-1.6%,-1.2%)}}
.hero-veil{positionabsolute;inset0;z-index1;backgroundlinear-gradient(100deg,rgba(27,24,21,.92) 8%,rgba(27,24,21,.55) 46%,rgba(27,24,21,.18) 75%,rgba(27,24,21,.5)),linear-gradient(to top,rgba(37,34,31,.95),transparent 40%)}
.sweep{positionabsolute;inset-20%;z-index2;pointer-eventsnone;backgroundlinear-gradient(115deg,transparent 42%,rgba(224,183,132,.09) 50%,transparent 58%);animationsweep 9s var(--e) infinite}
@keyframes sweep{0%{transformtranslateX(-30%)}55%,100%{transformtranslateX(30%)}}
.dust{positionabsolute;inset0;z-index2;pointer-eventsnone;overflowhidden}
.dust i{positionabsolute;width3px;height3px;border-radius50%;backgroundrgba(240,214,178,.75);box-shadow0 0 8px rgba(240,214,178,.6);opacity0;animationdust linear infinite}
@keyframes dust{0%{transformtranslate3d(0,20px,0);opacity0}12%{opacity.85}88%{opacity.5}100%{transformtranslate3d(var(--dx),-46vh,0);opacity0}}
.hero-in{positionrelative;z-index3;width100%;padding120px var(--pad) 110px;max-width1500px;margin0 auto}
.hero-frame{positionrelative;paddingclamp(22px,3vw,44px) clamp(22px,3.4vw,52px)}
.hero-framebefore{content'';positionabsolute;left0;top0;widthclamp(40px,5vw,80px);heightclamp(40px,5vw,80px);border-left1px solid var(--line2);border-top1px solid var(--line2)}
.hero-frameafter{content'';positionabsolute;right0;bottom0;widthclamp(40px,5vw,80px);heightclamp(40px,5vw,80px);border-right1px solid var(--line2);border-bottom1px solid var(--line2)}
.hero h1{font-sizeclamp(2.4rem,7.2vw,6.4rem);font-weight800;line-height.98;letter-spacing.015em;colorvar(--strong);max-width12ch}
.hero h1 .ln{displayblock;overflowhidden}
.hero h1 .lnspan{displayblock;transformtranslateY(105%);transitiontransform 1.1s var(--e);transition-delayvar(--d,0s)}
.loaded .hero h1 .lnspan{transformnone}
.hero p.sub{margin-topclamp(18px,2.4vw,30px);max-width44ch;font-sizeclamp(14px,1.2vw,16.5px);colorvar(--dim);line-height1.75}
.hero .hact{displayflex;gap14px;flex-wrapwrap;margin-topclamp(24px,3vw,40px)}
.hero-bottom{positionabsolute;leftvar(--pad);rightvar(--pad);bottomclamp(18px,3vh,34px);z-index3;displayflex;align-itemscenter;justify-contentspace-between;gap20px}
.hb-left{displayflex;align-itemscenter;gap14px}
.hb-left .lab{colorvar(--faint)}
.hb-right{font-sizeclamp(9px,1vw,12px);font-weight500;letter-spacing.5em;text-transformuppercase;colorvar(--dim)}
.arrow-d{width44px;height44px;border-radius50%;backgroundvar(--strong);color#1B1815;displaygrid;place-itemscenter;transition.4s;animationbob 2.6s var(--e) infinite}
.arrow-dhover{backgroundvar(--sand)}
@keyframes bob{0%,100%{transformtranslateY(0)}50%{transformtranslateY(7px)}}

 marquee 
.mq{border-top1px solid var(--line);border-bottom1px solid var(--line);overflowhidden;padding14px 0;backgroundvar(--deep)}
.mqt{displayflex;widthmax-content;animationmv 46s linear infinite}
@keyframes mv{to{transformtranslateX(-50%)}}
.mqt span{font-sizeclamp(11px,1.2vw,14px);font-weight500;letter-spacing.3em;text-transformuppercase;colorvar(--dim);padding0 clamp(16px,2.4vw,34px);displayinline-flex;align-itemscenter;gapclamp(16px,2.4vw,34px);white-spacenowrap}
.mqt spanafter{content'◆';font-size.5em;colorvar(--trav,#B49B7F);opacity.7}

 projects full-bleed 
.pj-sec{border-bottom1px solid var(--line)}
.pj-head{displayflex;align-itemsflex-end;justify-contentspace-between;gap24px;flex-wrapwrap;paddingclamp(56px,8vh,110px) 0 clamp(28px,4vw,54px)}
.pj-head h2{font-sizeclamp(1.9rem,4.6vw,3.6rem);colorvar(--strong)}
.pj-grid{displaygrid;grid-template-columns1fr 1fr;gap1px;backgroundvar(--line);border-top1px solid var(--line);border-bottom1px solid var(--line)}
.pj{positionrelative;overflowhidden;heightclamp(420px,76vh,760px);cursorpointer;background#141210}
.pj .sc{positionabsolute;inset0;will-changetransform}
.pj .sc svg,.pj .sc img{width100%;height100%;object-fitcover;transitiontransform 1.4s var(--e),filter 1s}
.pj .sc{filtersaturate(.9) brightness(.88)}
.pjhover .sc{filtersaturate(1) brightness(1)}
.pjhover .sc svg,.pjhover .sc img{transformscale(1.05)}
.pjafter{content'';positionabsolute;inset0;backgroundlinear-gradient(to top,rgba(17,15,14,.9),rgba(17,15,14,.1) 46%,transparent 70%);pointer-eventsnone}
.pj-num{positionabsolute;topclamp(16px,2vw,28px);leftclamp(16px,2vw,28px);z-index3;font-size11px;font-weight600;letter-spacing.24em;colorvar(--sand)}
.pj-cap{positionabsolute;left0;right0;bottom0;z-index3;paddingclamp(20px,2.6vw,38px);displayflex;align-itemsflex-end;justify-contentspace-between;gap18px}
.pj-cap h3{font-sizeclamp(1.15rem,2vw,1.8rem);font-weight700;letter-spacing.03em;colorvar(--strong);max-width22ch;transitioncolor .4s}
.pjhover .pj-cap h3{colorvar(--sand)}
.pj-cap .meta{font-size10.5px;font-weight500;letter-spacing.18em;text-transformuppercase;colorvar(--dim);margin-top8px}
.pj-go{flex0 0 auto;width52px;height52px;border1px solid var(--line2);border-radius50%;displaygrid;place-itemscenter;colorvar(--strong);transition.5s var(--e);opacity0;transformtranslateY(10px)}
.pjhover .pj-go{opacity1;transformnone;backgroundvar(--sand);color#1B1815;border-colorvar(--sand)}
.pj-drop{positionabsolute;inset0;z-index5;displaynone;place-itemscenter;backgroundrgba(27,24,21,.8);border1px dashed var(--line2);font-size11px;letter-spacing.2em;text-transformuppercase;colorvar(--sand)}
.pj.drag .pj-drop{displaygrid}

 philosophy pinned комната наполняется 
.phil{positionrelative;height340vh}
.phil-stick{positionsticky;top0;height100vh;displaygrid;grid-template-columns1fr 1.1fr;gapclamp(24px,4vw,70px);align-itemscenter;padding90px var(--pad) 60px;max-width1500px;margin0 auto}
.phil-txt h2{font-sizeclamp(1.7rem,3.6vw,3rem);colorvar(--strong);max-width14ch}
.phil-txt .lead{margin-top20px;font-sizeclamp(14px,1.2vw,17px);colorvar(--dim);max-width40ch;line-height1.8}
.principles{margin-topclamp(22px,3vh,40px);displaygrid;gap0;border-top1px solid var(--line)}
.principles li{displayflex;gap16px;align-itemsbaseline;padding13px 0;border-bottom1px solid var(--line);font-size14px;colorvar(--faint);transitioncolor .5s,padding-left .5s var(--e)}
.principles li b{font-size10px;font-weight600;letter-spacing.2em;colorvar(--faint);transitioncolor .5s}
.principles li.on{colorvar(--fg);padding-left10px}
.principles li.on b{colorvar(--sand)}
.room-svg{width100%;heightauto;max-height74vh}
.room-svg .ff{opacity0;transformtranslateY(30px);transitionopacity .9s var(--e),transform .9s var(--e)}
.room-svg .ff.on{opacity1;transformnone}
.no-js .room-svg .ff{opacity1;transformnone}
.phil-prog{positionabsolute;leftvar(--pad);bottom26px;height1px;widthcalc(100% - var(--pad)2);backgroundvar(--line)}
.phil-prog i{displayblock;height100%;backgroundvar(--sand);transformscaleX(0);transform-originleft}

 angle shift pinned 
.ang{positionrelative;height230vh}
.ang-stick{positionsticky;top0;height100vh;overflowhidden}
.ang-l{positionabsolute;inset0}
.ang-l .kb{positionabsolute;inset-4%}
.ang-b{clip-pathinset(0 0 0 100%)}
.ang-cap{positionabsolute;left0;right0;bottomclamp(26px,6vh,64px);z-index4;text-aligncenter}
.ang-cap h3{font-sizeclamp(1.5rem,4.4vw,3.4rem);colorvar(--strong)}
.ang-cap .a,.ang-cap .b{transitionopacity .5s,transform .6s var(--e)}
.ang-cap .b{positionabsolute;left0;right0;opacity0;transformtranslateY(14px)}
.ang-veil{positionabsolute;inset0;backgroundlinear-gradient(to top,rgba(27,24,21,.85),transparent 45%)}

 directions 
.dirs2{displaygrid;grid-template-columns1fr 1fr;gap1px;backgroundvar(--line)}
.dir2{positionrelative;heightclamp(360px,64vh,620px);overflowhidden;cursorpointer;background#141210}
.dir2 .bg{positionabsolute;inset0;filterbrightness(.72) saturate(.85);transitiontransform 1.5s var(--e),filter .8s}
.dir2hover .bg{transformscale(1.06);filterbrightness(.9) saturate(1)}
.dir2 .in{positionabsolute;insetauto 0 0 0;paddingclamp(22px,3vw,44px);z-index3;backgroundlinear-gradient(to top,rgba(17,15,14,.9),transparent)}
.dir2 h3{font-sizeclamp(1.4rem,3vw,2.5rem);colorvar(--strong)}
.dir2 .cnt{font-size10.5px;font-weight500;letter-spacing.22em;text-transformuppercase;colorvar(--sand);margin-bottom10px;displayblock}
.dir2 .ar{positionabsolute;topclamp(18px,2.4vw,32px);rightclamp(18px,2.4vw,32px);width50px;height50px;border1px solid var(--line2);border-radius50%;displaygrid;place-itemscenter;colorvar(--strong);transition.5s var(--e);z-index3}
.dir2hover .ar{backgroundvar(--sand);color#1B1815;transformrotate(45deg)}

 facts 
.facts{displaygrid;grid-template-columnsrepeat(4,1fr);gap1px;backgroundvar(--line);border-bottom1px solid var(--line)}
.fact{backgroundvar(--bg);paddingclamp(24px,3.4vw,44px) clamp(16px,2vw,30px);transitionbackground .5s}
.facthover{backgroundvar(--soft)}
.fact b{displayblock;font-sizeclamp(2.2rem,4.6vw,3.6rem);font-weight200;letter-spacing.02em;colorvar(--strong)}
.fact span{displayblock;margin-top10px;font-size10px;font-weight500;letter-spacing.2em;text-transformuppercase;colorvar(--faint)}

 process horizontal pinned 
.phs{positionrelative;border-bottom1px solid var(--line)}
.phs .stick{displayflex;align-itemscenter;overflowhidden;paddingclamp(50px,8vh,90px) 0}
.phs .track{displayflex;gapclamp(16px,2vw,32px);padding0 var(--pad);will-changetransform}
.phs.pin{height320vh}
.phs.pin .stick{positionsticky;top0;height100vh;padding0}
.pstep{flex0 0 clamp(280px,30vw,420px);border1px solid var(--line);backgroundvar(--soft);paddingclamp(22px,2.6vw,38px);displayflex;flex-directioncolumn;gap14px;min-heightclamp(300px,44vh,420px)}
.pstep b{font-size11px;font-weight600;letter-spacing.24em;colorvar(--sand)}
.pstep h3{font-sizeclamp(1.1rem,1.8vw,1.6rem);colorvar(--strong);letter-spacing.03em}
.pstep p{font-size13.5px;colorvar(--dim);line-height1.75}
.pstep ul{margin-topauto;displaygrid;gap7px;border-top1px solid var(--line);padding-top14px}
.pstep li{font-size12px;colorvar(--dim);padding-left16px;positionrelative}
.pstep libefore{content'';positionabsolute;left0;top.6em;width8px;height1px;backgroundvar(--trav,#B49B7F)}
.pstep .dur{font-size10px;font-weight600;letter-spacing.18em;text-transformuppercase;colorvar(--sand);border1px solid var(--line2);border-radius100px;padding7px 14px;align-selfflex-start}
.no-js .phs .track{flex-directioncolumn}
.no-js .phs .stick{padding40px 0}

 cta + form 
.cta-sec{backgroundvar(--deep);border-top1px solid var(--line)}
.cta-sec h2{font-sizeclamp(2rem,6.4vw,5rem);colorvar(--strong);max-width16ch}
.cg{displaygrid;grid-template-columns1fr 1fr;gapclamp(36px,6vw,90px);margin-topclamp(36px,6vw,70px);align-itemsstart}
.ci{padding18px 0;border-bottom1px solid var(--line);displayflex;justify-contentspace-between;gap16px;align-itemsbaseline}
.cifirst-child{border-top1px solid var(--line)}
.ci span{font-size9.5px;font-weight600;letter-spacing.2em;text-transformuppercase;colorvar(--faint)}
.ci a,.ci p{font-sizeclamp(1rem,1.6vw,1.3rem);font-weight500;colorvar(--strong);text-alignright;transitioncolor .4s}
.ci ahover{colorvar(--sand)}
.form{displaygrid;gap24px}
.fd{positionrelative}
.fd input,.fd select,.fd textarea{width100%;backgroundtransparent;border0;border-bottom1px solid var(--line);padding18px 0 11px;font-familyvar(--sans);font-size15px;font-weight300;colorvar(--strong);outlinenone;border-radius0;transitionborder-color .5s}
.fd textarea{resizevertical;min-height80px}
.fd select{appearancenone;-webkit-appearancenone;cursorpointer;background-imageurl(dataimagesvg+xml;utf8,svg xmlns='httpwww.w3.org2000svg' width='12' height='8'path d='M1 1l5 5 5-5' fill='none' stroke='%23C6AE94' stroke-width='1.2'svg);background-repeatno-repeat;background-positionright 4px center}
.fd select option{background#211E1B;color#D8C6BB}
.fd label{positionabsolute;left0;top16px;font-size14px;colorvar(--faint);pointer-eventsnone;transitiontransform .5s var(--e),font-size .5s,color .4s}
.fd.filled label,.fd inputfocus~label,.fd selectfocus~label,.fd textareafocus~label{transformtranslateY(-17px);font-size9.5px;font-weight600;letter-spacing.2em;text-transformuppercase;colorvar(--sand)}
.fd inputfocus,.fd selectfocus,.fd textareafocus{border-bottom-colorvar(--sand)}
.fd.err input,.fd.err select{border-bottom-color#C0705C}
.cs{displayflex;gap13px;align-itemsflex-start;font-size12px;colorvar(--faint);line-height1.6;cursorpointer}
.cs input{positionabsolute;opacity0}
.cs .bx{flex0 0 auto;width18px;height18px;border1px solid var(--line2);margin-top2px;positionrelative;transition.4s}
.cs .bxafter{content'';positionabsolute;left5px;top2px;width5px;height9px;bordersolid #1B1815;border-width0 1.4px 1.4px 0;transformrotate(45deg) scale(0);transitiontransform .35s var(--e)}
.cs inputchecked~.bx{backgroundvar(--sand);border-colorvar(--sand)}
.cs inputchecked~.bxafter{transformrotate(45deg) scale(1)}
.fok{border1px solid var(--line2);paddingclamp(26px,4vw,44px);text-aligncenter;displaynone}
.fok.show{displayblock}
.fok h4{font-size1.4rem;colorvar(--strong);margin-bottom10px}
.fok p{font-size14px;colorvar(--dim)}

 footer 
.foot{border-top1px solid var(--line);paddingclamp(30px,4vw,50px) 0;backgroundvar(--deep)}
.foot-in{displayflex;align-itemscenter;justify-contentspace-between;gap24px;flex-wrapwrap}
.foot-logo{font-sizeclamp(1.2rem,2.4vw,1.8rem);font-weight300;letter-spacing.5em;colorvar(--logo)}
.foot-nav{displayflex;gapclamp(14px,2vw,28px);flex-wrapwrap}
.foot-nav a{font-size10.5px;font-weight500;letter-spacing.16em;text-transformuppercase;colorvar(--dim);transitioncolor .4s}
.foot-nav ahover{colorvar(--sand)}
.foot-sub{displayflex;justify-contentspace-between;gap18px;flex-wrapwrap;margin-top26px;padding-top22px;border-top1px solid var(--line);font-size10px;font-weight500;letter-spacing.14em;text-transformuppercase;colorvar(--faint)}

 reveal 
.rv{opacity0;transformtranslateY(26px);transitionopacity 1s var(--e),transform 1s var(--e);transition-delayvar(--d,0s)}
.rv.in{opacity1;transformnone}
.no-js .rv{opacity1;transformnone}

 hint chip 
.hint{positionfixed;left16px;bottom16px;z-index9600;max-width280px;backgroundrgba(27,24,21,.94);border1px solid var(--line2);border-radius14px;padding12px 34px 12px 14px;font-size11px;line-height1.5;colorvar(--dim)}
.hint b{colorvar(--sand);font-weight600}
.hint button{positionabsolute;top6px;right8px;font-size14px;colorvar(--faint)}
.hint.gone{displaynone}

@media (max-width1080px){
  .nav-l{displaynone}
  .btn.icon{displayinline-flex}
  .nav-r .btnnot(.icon){displaynone}
  .nav-r .socs{displaynone}
  .phil-stick{grid-template-columns1fr;align-contentcenter;gap20px}
  .room-svg{max-height44vh}
  .facts{grid-template-columnsrepeat(2,1fr)}
  .cg{grid-template-columns1fr}
  .dots{displaynone}
}
@media (max-width860px){
  .pj-grid,.dirs2{grid-template-columns1fr}
  .pj{heightclamp(380px,66vh,600px)}
  .phs.pin{heightauto}
  .phs.pin .stick{positionstatic;heightauto;padding40px 0}
  .phs .track{flex-directioncolumn}
  .pstep{flex0 0 auto;min-height0}
  .ang{height160vh}
}
@media (max-width560px){
  .hero-bottom{flex-directioncolumn;align-itemsflex-start;gap14px}
  .hb-right{letter-spacing.3em}
  .facts{grid-template-columns1fr 1fr}
}
@media (prefers-reduced-motionreduce){
  {animation-duration.01ms!important;animation-iteration-count1!important;transition-duration.15s!important}
  html{scroll-behaviorauto}.hero-bg .kb,.sweep,.dust i{animationnone}
}
